{
  "name": "manifests-io-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/build-renderer.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:edge": "node --test scripts/worker-runtime.test.mjs ../edge/worker.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@grafana/faro-web-sdk": "^2.12.1",
    "@grafana/faro-web-tracing": "^2.12.1",
    "fuse.js": "7.5.0",
    "posthog-js": "^1.438.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@grafana/faro-bundlers-shared": "0.13.2",
    "@grafana/faro-rollup-plugin": "0.13.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "miniflare": "5.20260911.0-alpha",
    "typescript": "^7.0.2",
    "url-search-params-polyfill": "8.2.5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
